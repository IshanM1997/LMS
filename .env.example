# backend/.env.example
# Copy this file to .env and fill in real values

# Django
SECRET_KEY=your-very-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
FRONTEND_URL=http://localhost:4200

# Database (matches docker-compose)
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# AWS S3 (video storage & signed URLs)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=lms-videos
AWS_S3_REGION_NAME=us-east-1
# Signed URL validity in seconds (1 hour)
AWS_SIGNED_URL_EXPIRY=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@lms.com
